<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Vijay Apartment Care</title><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"><script src="https://cdn.tailwindcss.com"></script><script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script><script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script><script>tailwind.config={theme:{extend:{fontFamily:{sans:['Inter','system-ui','sans-serif']},colors:{slate:{50:#f8fafc,100:#f1f5f9,200:#e2e8f0,300:#cbd5e1,400:#94a3b8,500:#64748b,600:#475569,700:#1e293b,800:#0f172a,900:#1e293b},{blue:{50:#eff6ff,100:#dbeafe,200:#bfdbfe,300:#93c5fd,400:#60a5fa,500:#3b82f6,600:#2563eb,700:#1d4ed8,800:#1e40af,900:#1e3a82},{green:{50:#f0fdf4,100:#cffdf3,200:#a3e635,300:#84cc16,400:#65a30d,500:#10b981,600:#059669,700:#047857,800:#065f46,900:#064e3b},{amber:{50:#fffaf0,100:#fed7aa,200:#fbbf24,300:#f59e0b,400:#eab308,500:#f59e0b,600:#d97706,700:#b45309,800:#92400e,900:#78350f},{red:{50:#fef2f2,100:#fecaca,200:#f87171,300:#ef4444,400:#f87171,500:#ef4444,600:#dc2626,700:#b91c1c,800:#991b1b,900:#7f1d1d},{sky:{50:#f0fdfb,100:#ccfbf1,200:#93c5fd,300:#60a5fd,400:#3b82f6,500:#06b6d4,600:#0891b2,700:#0f766e,800:#1098bc,900:#0c4a6e}}},backgroundColor:({type:'any',space:$theme.space}),textColor:({type:'any',inherit:$theme.extend.color,solid:$theme.extend.color}),borderColor:({type:'any',inherit:$theme.extend.color,solid:$theme.extend.color})}};</script><style>*:font-family:'Inter',system-ui,sans-serif;::-webkit-scrollbar{width:5px}::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:3px}.kc{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:20px;transition:box-shadow .2s}.kc:hover{box-shadow:0 4px 20px rgba(0,0,0,.05)}.btn{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;border:none;transition:.15s}.bp{background:#2563eb;color:#fff}.bp:hover{background:#1d4ed8}.bs{background:#f1f5f9;color:#475569;border:1px solid #e2e8f0}.bs:hover{background:#e2e8f0}.bd{background:#ef4444;color:#fff}.bd:hover{background:#dc2626}.bx{padding:6px 12px;font-size:12px;border-radius:8px}.badge{display:inline-flex;align-items:center;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600}.bs-s{background:#dcfce7;color:#166534}.bs-w{background:#fef3c7;color:#92400e}.bs-d{background:#fee2e2;color:#991b1b}.bs-i{background:#dbeafe;color:#1e40af}.bs-n{background:#f1f5f9;color:#475569}.mo{position:fixed;inset:0;background:rgba(15,23,42,.45);backdrop-filter:blur(4px);z-index:100;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .2s}.mo.on{opacity:1;pointer-events:auto}.md{background:#fff;border-radius:16px;width:90%;max-width:520px;max-height:85vh;overflow-y:auto;box-shadow:0 25px 60px rgba(0,0,0,.15);transform:translateY(12px);transition:transform .2s}.mo.on .md{transform:translateY(0)}.tc{position:fixed;top:20px;right:20px;z-index:200;display:flex;flex-direction:column;gap:8px}.ts{padding:12px 18px;border-radius:12px;font-size:13px;font-weight:500;color:#fff;box-shadow:0 8px 30px rgba(0,0,0,.12);animation:si .3s;display:flex;align-items:center;gap:8px;min-width:260px}.t-s{background:#16a34a}.t-e{background:#dc2626}.t-w{background:#d97706}.t-i{background:#2563eb}@keyframes si{from{transform:translateX(100%);opacity:0}to{transform:translateX(0);opacity:1}}.tb{background:#fff;border:1px solid #e2e8f0;border-radius:14px;overflow:hidden}.tb table{width:100%;border-collapse:collapse}.tb th{text-align:left;padding:12px 14px;font-size:11px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.04em;background:#f8fafc;border-bottom:1px solid #e2e8f0}.tb td{padding:12px 14px;font-size:13px;border-bottom:1px solid #f1f5f9;color:#334155}.tb tr:hover td{background:#f8fafc}.in{width:100%;padding:9px 12px;border:1px solid #e2e8f0;border-radius:10px;font-size:13px;transition:border .15s;background:#fff;color:#1e293b}.in:focus{outline:none;border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.1)}.se{width:100%;padding:9px 12px;border:1px solid #e2e8f0;border-radius:10px;font-size:13px;background:#fff;color:#1e293b}.se:focus{outline:none;border-color:#2563eb}.fl{display:block;font-size:13px;font-weight:600;color:#475569;margin-bottom:5px}.es{text-align:center;padding:50px 20px;color:#94a3b8}.sk{background:linear-gradient(90deg,#f1f5f9 25%,#e2e8f0 50%,#f1f5f9 75%);background-size:200% 100%;animation:sh 1.5s infinite;border-radius:8px;height:120px}@keyframes sh{0%{background-position:200% 0}100%{background-position:-200% 0}}.av{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-weight:600;font-size:13px;color:#fff;flex-shrink:0}.tb2{height:32px;padding:0 16px;font-size:13px;font-weight:600;color:#94a3b8;cursor:pointer;border-bottom:2px solid transparent;transition:.15s}.tb2.on{color:#2563eb;border-bottom-color:#2563eb}.pb{height:7px;background:#e2e8f0;border-radius:4px;overflow:hidden}.pf{height:100%;border-radius:4px;transition:width .5s}.sp{background:#fff;border-radius:16px;width:90%;max-width:560px;box-shadow:0 25px 60px rgba(0,0,0,.2)}.sr{position:fixed;inset:0;background:rgba(15,23,42,.5);z-index:150;display:flex;align-items:flex-start;justify-content:center;padding-top:120px;opacity:0;pointer-events:none;transition:opacity .2s}.sr.on{opacity:1;pointer-events:auto}.sr .sp{max-width:480px;padding:20px}.nav-link{position:relative;padding-bottom:2px}.nav-link::after{content:'';position:absolute;bottom:0;left:0;width:0;height:2px;background:#2563eb;transition:width .2s}.nav-link:hover::after,.nav-link.active::after{width:100%}.focus-visible:focus{outline:2px solid #2563eb;outline-offset:2}.sr-only{position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip:rect(0,0,0,0);border:0}.placeholder-slate::-webkit-input-placeholder{color:#94a3b8}.placeholder-slate:-moz-placeholder{color:#94a3b8}.placeholder-slate::-moz-placeholder{color:#94a3b8}.placeholder-slate:-ms-input-placeholder{color:#94a3b8}.toast{position:fixed;bottom:20px;left:50;transform:translateX(-50%);z-index:300;animation:slideIn .3s}.toast-hidden{display:none}.@keyframes slideIn{from{transform:translateX(-50%) translateY(100px);opacity:0}to{transform:translateX(-50%) translateY(0);opacity:1}}</style></head><body class="bg-slate-50"><!-- Toast Container --><div id="tc" class="tc"></div><!-- Login Page --><div id="login-page" class="lp"><div class="bg-white rounded-2xl shadow-2xl p-10 w-full max-w-md"><div class="text-center mb-8"><div class="inline-flex items-center justify-center w-14 h-14 bg-blue-600 rounded-2xl mb-4"><i data-lucide="building-2" class="w-7 h-7 text-white"></i></div><h1 class="text-xl font-bold text-slate-900">Vijay Apartment Care</h1><p class="text-sm text-slate-500 mt-1">Apartment Maintenance Management System</p></div><div id="login-error" class="hidden bg-red-50 text-red-600 text-sm px-4 py-3 rounded-xl mb-4"></div><form id="login-form"><div class="mb-4"><label class="fl">Email</label><input type="email" id="login-email" class="in placeholder-slate" placeholder="Enter email" required></div><div class="mb-6"><label class="fl">Password</label><input type="password" id="login-password" class="in placeholder-slate" placeholder="Enter password" required></div><button type="submit" class="btn bp w-full justify-center py-3" id="login-btn">Sign In</button></form><p class="text-xs text-slate-400 text-center mt-6">Admin: admin@vijayapartment.com / admin123<br>Resident: priya.sharma@example.com / resident123 / vikram.singh@example.com / resident123</p></div></div><!-- App Shell --><div id="app"><!-- Sidebar --><aside id="sidebar" class="fixed left-0 top-0 h-full bg-white border-r border-slate-200 z-40 transition-all duration-200 flex flex-col" style="width:260px"><div class="px-5 py-5 flex items-center gap-3 border-b border-slate-100"><div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center"><i data-lucide="building-2" class="w-5 h-5 text-white"></i></div><div id="sb-brand"><p class="font-bold text-slate-900 text-sm">Vijay Apartment Care</p><p class="text-xs text-slate-400" id="sb-role">Admin Panel</p></div><button onclick="toggleSB()" class="ml-auto p-1.5 rounded-lg hover:bg-slate-100 text-slate-400"><i data-lucide="panel-left-close" class="w-4 h-4"></i></button></div><nav class="flex-1 overflow-y-auto px-3 py-3 space-y-1" id="sb-nav"></nav><div class="px-3 py-4 border-t border-slate-100"><div class="sl text-red-500 hover:bg-red-50 hover:text-red-600" onclick="logout()"><i data-lucide="log-out"></i><span>Logout</span></div></div></aside><!-- Main Area --><div id="main-area" class="transition-all duration-200" style="margin-left:260px"><header class="sticky top-0 bg-white/80 backdrop-blur-lg border-b border-slate-200 z-30 h-16 flex items-center px-6 gap-4 lg:px-12"><button onclick="openMob()" class="lg:hidden p-2 rounded-lg hover:bg-slate-100"><i data-lucide="menu" class="w-5 h-5 text-slate-600"></i></button><div id="crumb" class="text-sm text-slate-500 hidden sm:block"></div><div class="ml-auto flex items-center gap-2"><button onclick="openSearch()" class="p-2 rounded-lg hover:bg-slate-100 text-slate-500" title="Search (Ctrl+K)"><i data-lucide="search" class="w-5 h-5"></i></button><div class="relative"><button onclick="togNotif()" class="p-2 rounded-lg hover:bg-slate-100 text-slate-500 relative"><i data-lucide="bell" class="w-5 h-5"></i><span id="nb" class="hidden absolute -top-0.5 -right-0.5 w-4 h-4 bg-red-500 rounded-full text-[9px] text-white font-bold flex items-center justify-center"></span></button><div id="n-dd" class="hidden absolute right-0 top-12 w-80 bg-white rounded-xl shadow-xl border border-slate-200 max-h-96 overflow-y-auto"></div></div><div class="flex items-center gap-3 pl-2 border-l border-slate-200 cursor-pointer" onclick="nav('dashboard')"><div id="h-av" class="av bg-blue-600"></div><div class="hidden md:block"><p class="text-sm font-semibold text-slate-800" id="h-name"></p><p class="text-xs text-slate-400" id="h-role"></p></div></div><div id="pm" class="hidden absolute right-6 top-16 w-48 bg-white rounded-xl shadow-xl border border-slate-200 py-1 z-50"><div class="px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="nav('my-profile')"><i data-lucide="user" class="w-4 h-4 inline mr-2"></i>My Profile</div><div class="px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 cursor-pointer" onclick="nav('settings')"><i data-lucide="settings" class="w-4 h-4 inline mr-2"></i>Settings</div><hr class="my-1 border-slate-100"><div class="px-4 py-2 text-sm text-red-500 hover:bg-red-50 cursor-pointer" onclick="logout()"><i data-lucide="log-out" class="w-4 h-4 inline mr-2"></i>Logout</div></div></header><main class="p-6 lg:p-12" id="content"></main></div><div id="mob-o" class="fixed inset-0 bg-black/40 z-50 hidden" onclick="closeMob()"></div><div id="sr-o" class="sr" onclick="closeSearch()"><div class="sp" onclick="event.stopPropagation()"><div class="flex items-center gap-3 px-5 py-4 border-b border-slate-100"><i data-lucide="search" class="w-5 h-5 text-slate-400"></i><input type="text" id="si" class="flex-1 text-sm outline-none bg-transparent placeholder-slate" placeholder="Search houses, residents, complaints..."><kbd class="text-[10px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded">ESC</kbd></div><div id="s-r" class="max-h-96 overflow-y-auto p-2"></div></div></div></body><script>lucide.createIcons()</script></html>